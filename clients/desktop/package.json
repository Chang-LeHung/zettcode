{
  "name": "zettcode-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "The ZettCode desktop app: a window on the gateway you choose, with a list of servers",
  "author": {
    "name": "Chang LeHung",
    "email": "changlehung@gmail.com"
  },
  "homepage": "https://github.com/Chang-LeHung/zettcode/tree/main/clients/desktop#readme",
  "type": "module",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "dev.zettcode.desktop",
    "productName": "ZettCode",
    "icon": "assets/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "web/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "category": "Development",
      "target": ["AppImage", "deb", "tar.gz"]
    }
  }
}
