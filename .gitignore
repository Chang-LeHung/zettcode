**/.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.smoke/
.coverage
**/.pytest_cache/
**/.ruff_cache/
.zett-tool-output/
.env
.DS_Store

# viztracer writes its trace here by default.
/result.json

# The docs site: dependencies, build output, and VitePress' cache.
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/.vitepress/.temp/

# The TypeScript client is built from its sources; only dist/ is published.
clients/typescript/dist/

# The gateway's page is built from clients/gateway into the package when a distribution is made (`make gateway-ui`);
# the build output is not kept in the repository. pyproject's `artifacts` puts it in the wheel all the same.
zettcode/src/zettcode/gateway/static/

# The palette gallery is generated by `make palettes`: every widget painted in
# every palette, written by docs/scripts/palette_gallery.py. Regenerate it
# rather than committing a 2 MB copy that goes stale the moment a colour moves.
docs/internal/palettes.html
